# Copy to `.env` at the repository root. Every value below is a non-secret
# prototype default; the app runs without a `.env` file.
#
# There are no credentials in this project by design: payments are mocked,
# OTP is returned by the demo API, and no email or video service is called.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
# SQLite file. Relative paths resolve from apps/api.
DATABASE_PATH=./data/lmns.db

# --- Product variables (prototype scope D3, D4, D2) ------------------------
# Platform booking fee in IDR. Never hard-code this in UI copy.
PLATFORM_FEE_IDR=50000
# Demo OTP returned in the API response for every account (no email is sent).
DEMO_OTP=123456
# Comma-separated suffix allowlist for mentee registration.
ALLOWED_EMAIL_DOMAINS=ac.id,edu
# Tier display labels, JSON. Change copy without touching code.
# TIER_LABELS={"BASIC":"Basic Mentor","EDUCATOR_STANDARD":"Educator Mentor","EDUCATOR_PREMIUM":"Premium Educator Mentor"}

# --- Web (Vite) ------------------------------------------------------------
# Vite serves on 5173 and proxies /api to PORT above.
WEB_PORT=5173
